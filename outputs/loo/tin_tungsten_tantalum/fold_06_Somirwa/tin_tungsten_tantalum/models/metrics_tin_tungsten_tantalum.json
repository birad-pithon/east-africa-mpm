    "config_snapshot": "# \u2500\u2500 Karagwe-Ankole Belt (KAB) configuration \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n# Covers the KAB in Rwanda, with Sn-W-Ta targets (tin, tungsten, tantalum)\n# plus shared infrastructure data from USGS MRDS.\n\n# Common analysis grid\ngrid:\n  crs: \"EPSG:32736\"        # UTM Zone 36S \u2014 covers Rwanda\n  resolution_m: 30          # 30 m to match SRTM / Landsat\n  # AOI bounding box in WGS 84 (lon, lat)\n  aoi_wgs84:\n    min_lon: 29.4\n    max_lon: 30.6\n    min_lat: -2.4\n    max_lat: -1.2\n  # Derived extent in target CRS (filled at runtime)\n  aoi_utm: null             # [min_x, min_y, max_x, max_y] in metres\n\n# \u2500\u2500 Data sources \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nsources:\n  usgs_mrds:\n    name: \"USGS Mineral Resources Data System (MRDS)\"\n    shapefile_url: \"https://mrdata.usgs.gov/mrds/mrds-trim.zip\"\n    csv_url: \"https://mrdata.usgs.gov/mrds/mrds-csv.zip\"\n    wfs_url: \"https://mrdata.usgs.gov/services/wfs/mrds\"\n    commodities:\n      - \"Tin\"             # MRDS commodity code: Sn-related\n      - \"Tungsten\"\n      - \"Tantalum\"\n      - \"Copper\"\n      - \"Zinc\"\n      - \"Bauxite\"\n      - \"Aluminum\"        # MRDS uses this for bauxite/alumina\n    africa_bbox:\n      min_lon: 10.0       # westernmost Africa longitude\n      max_lon: 50.0       # easternmost Africa longitude\n      min_lat: -35.0      # southernmost Africa latitude\n      max_lat: 37.0       # northernmost Africa latitude\n\n  sentinel2:\n    collection: \"COPERNICUS/S2_SR_HARMONIZED\"\n    bands:\n      - B2   # Blue   (10 m)\n      - B3   # Green  (10 m)\n      - B4   # Red    (10 m)\n      - B8   # NIR    (10 m)\n      - B11   # SWIR1  (20 m)\n      - B12   # SWIR2  (20 m)\n    # Dry season in Rwanda: June\u2013September (Southern Hemisphere winter)\n    date_range:\n      start: \"2023-06-01\"\n      end: \"2023-09-30\"\n    cloud_cover_threshold: 0.20\n    scale_m: 30           # resample all bands to 30 m\n\n  srtm_dem:\n    collection: \"USGS/SRTMGL1_003\"\n    resolution_m: 30\n\n# \u2500\u2500 Feature engineering \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfeatures:\n  # Explicit feature-raster allowlist (SAFEGUARD): paths relative to\n  # data/interim. Only these files may enter training / prediction for\n  # the group \u2014 a stray GeoTIFF in data/interim cannot poison the model.\n  rasters_by_group:\n    tin_tungsten_tantalum:\n      - dem/srtm_kabar_aligned.tif\n      - sentinel2/sentinel2_kabar_aligned.tif\n      - features/terrain_features_kabar.tif\n      - features/geology_features_kabar.tif\n      - features/alteration_features_kabar.tif\n      - features/deposit_distance_tin_tungsten_tantalum.tif\n\n  # Sn / W / Ta (Karagwe-Ankole Belt)\n  tin_tungsten_tantalum:\n    distance_to:\n      - faults\n      - granite_contacts\n    magnetic_gradients: true\n    lithology_encoding: true\n\n  # Cu / Zn (Central African Copperbelt)\n  copper_zinc:\n    stratigraphic_proxies: true\n    structural_traps: true\n    geochemical_anomaly_surfaces: true\n\n  # Bauxite (lateritic plateaus, Tanzania)\n  bauxite:\n    spectral_indices:\n      - NDWI   # Normalized Difference Water Index\n      - MBI    # Mud-sand Bimodal Index (for laterite)\n      - BSI    # Brightness/Surface Index\n    slope_threshold_deg: 5\n    plateau_flatness: true\n\n# \u2500\u2500 Model settings \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nmodel:\n  commodity_groups:\n    - tin_tungsten_tantalum\n    - copper_zinc\n    - bauxite\n  algorithm: \"random_forest\"\n  params:\n    # Tuned via Optuna TPE (50 trials, spatial CV) \u2014 best xgb config:\n    # mean AP 0.082 vs 0.037 default.\n    n_estimators: 150\n    max_depth: 3\n    learning_rate: 0.298\n    subsample: 0.917\n    colsample_bytree: 0.593\n    min_child_weight: 7\n    min_samples_leaf: 3\n    random_state: 42\n  compare_algorithms:\n    - random_forest\n    - xgboost\n    - lightgbm\n\n# \u2500\u2500 Spatial cross-validation \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nvalidation:\n  method: \"spatial_block\"\n  n_groups: 5\n  buffer_km: 5\n  min_train_area_pct: 60"
  },
